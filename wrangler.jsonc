{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kimchou-ict",
  "account_id": "77fa8828b4edb71086e716e10532ae55",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/favicon.ico"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jdchou1",
      "database_id": "3ef883bd-0267-4888-880a-ffca8a2acb98",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "jd-analysis-uploads"
    }
  ],
  "vars": {
    "APP_NAME": "JD ANALYSIS",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "DEEPSEEK_VISION_MODEL": "deepseek-flash",
    "DEEPSEEK_CHAT_MODEL": "deepseek-flash",
    "MAX_UPLOAD_MB": "12",
    "CONFIDENCE_MINIMUM": "65",
    "PRICE_AGREEMENT_ABSOLUTE": "0.50",
    "ATR_AGREEMENT_PERCENT": "0.20",
    "FORCE_SIGNAL": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
